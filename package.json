{
  "name": "recibo-certo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs && node scripts/gen-novidades.mjs",
    "novidades:gen": "node scripts/gen-novidades.mjs",
    "novidades:check": "node scripts/gen-novidades.mjs --check",
    "build": "next build",
    "start": "next start",
    "fiscal:check": "node scripts/check-fiscal-data.mjs",
    "fiscal:check:sources": "node scripts/check-fiscal-data.mjs --check-sources",
    "seo:audit": "node scripts/seo-audit.mjs",
    "skills:sync": "node scripts/sync-skills-fiscal.mjs",
    "skills:check": "node scripts/sync-skills-fiscal.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "guias:lint": "vitest run src/lib/__tests__/guias.test.ts -t \"guias:lint\"",
    "guias:sources": "vitest run src/lib/__tests__/guias.test.ts -t \"guias:sources\"",
    "guias:claims": "vitest run src/lib/__tests__/guias.test.ts -t \"guias:claims\"",
    "guias:routes": "vitest run src/lib/__tests__/guias.test.ts -t \"guias:routes\"",
    "guias:fiz-contract": "vitest run src/lib/__tests__/guias.test.ts -t \"guias:fiz-contract\"",
    "guias:seo": "vitest run src/lib/__tests__/guias.test.ts -t \"guias:seo\"",
    "guias:year-rollover": "vitest run src/lib/__tests__/guias.test.ts -t \"guias:year-rollover\"",
    "guias:links": "node scripts/check-guias.mjs",
    "guias:semantics": "node scripts/check-guias.mjs",
    "guias:check": "vitest run src/lib/__tests__/guias.test.ts src/lib/__tests__/fiz.test.ts && node scripts/check-guias.mjs",
    "guias:expansao": "vitest run src/lib/__tests__/guias-expansao.test.ts",
    "guias:expansao:loop": "node scripts/verificar-expansao.mjs",
    "guias:expansao:hash": "node scripts/verificar-expansao.mjs --hash",
    "quiz:meta": "node scripts/gen-quiz-meta.mjs",
    "quiz:meta:check": "node scripts/gen-quiz-meta.mjs --check",
    "quiz:fiscal-check": "vitest run src/lib/__tests__/quiz-fiscal-check.test.ts",
    "quiz:check": "vitest run src/lib/__tests__/quiz-banco-integridade.test.ts src/lib/__tests__/quiz-fiscal-check.test.ts src/lib/__tests__/quiz-novos-bancos.test.ts && node scripts/gen-quiz-meta.mjs --check",
    "parcerias:check": "vitest run src/lib/__tests__/parcerias.test.ts",
    "parcerias:copy": "vitest run src/lib/__tests__/parcerias.test.ts -t \"parcerias:copy\"",
    "parcerias:links": "vitest run src/lib/__tests__/parcerias.test.ts -t \"parcerias:links\"",
    "parcerias:sem-estado": "vitest run src/lib/__tests__/parcerias.test.ts -t \"parcerias:sem-estado\"",
    "parcerias:demo": "vitest run src/lib/__tests__/parcerias.test.ts -t \"parcerias:demo\"",
    "docs:fontes": "python3 scripts/preparar-fontes.py",
    "docs:fontes:check": "python3 scripts/preparar-fontes.py --verificar",
    "docs:build": "python3 scripts/compor-documento.py",
    "docs:verify": "python3 scripts/verificar-documentos.py out/relatorio-vencimento.pdf out/mapa-recibos.pdf out/declaracao-irs.pdf && node scripts/verificar-texto-pdf.mjs out/relatorio-vencimento.pdf out/mapa-recibos.pdf out/declaracao-irs.pdf",
    "docs": "npm run docs:fontes:check && npm run docs:build && npm run docs:verify",
    "security:boundary": "node scripts/check-security-boundary.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "motion": "^12.40.0",
    "next": "^16.2.6",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.12.4",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.5.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "nanoid": "^3.3.17",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "not dead"
  ],
  "license": "UNLICENSED"
}
