# ── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Stripe (usar chaves live para produção) ─────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook das CONTAS LIGADAS (Connect). Endpoint separado, e por isso
# segredo separado: aceitar um evento de uma conta de contabilista com a
# assinatura da plataforma seria aceitar o que não se consegue verificar.
# Criar em Stripe → Programadores → Webhooks → «Ligar a contas ligadas»,
# a apontar para /api/stripe/connect-webhook.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# ── Resend (email) ──────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── App ─────────────────────────────────────────────────────────
# Origem canónica: TEM de ser o host que o site serve (o apex responde 307
# para o www). É a partir daqui que se constroem os URLs de retorno da Stripe
# e o redirect_uri do OAuth da FIZ, e esses são comparados literalmente pelo
# fornecedor. Em pré-visualização, usar o URL da própria pré-visualização.
NEXT_PUBLIC_APP_URL=https://www.recibocerto.pt

# ── SEO / verificação de propriedade (ver docs/SEO.md) ──────────
# Código de verificação do Google Search Console (método "tag HTML").
# Cola só o valor do content="..." da meta tag fornecida pelo Google.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Código de verificação do Bing Webmaster Tools (meta msvalidate.01).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Recibo Certo Plus ───────────────────────────────────────────
# Os preços são resolvidos pelas lookup_keys `recibocerto_plus_monthly` e
# `recibocerto_plus_lifetime` e validados no servidor. Estas variáveis são
# fallbacks opcionais para instalações antigas; nunca são fonte de verdade.
# Preço mensal de 1,99 € (ver src/lib/entitlements.ts).
STRIPE_PRICE_PLUS_MONTHLY=price_...
# Compra única do Plus (19,99 €), one-time, com impostos incluídos.
STRIPE_PRICE_PLUS_LIFETIME=price_...
# Preços antigos que ainda devem conceder Plus a quem os subscreveu,
# separados por vírgulas se existir mais do que um.
STRIPE_PRICE_PLUS_LEGACY=price_...

# ── Integração FIZ (parceiro de execução fiscal) ────────────────
# A integração está DESLIGADA por omissão. Só deve ser ativada quando o
# percurso completo estiver validado pelas duas equipas (ponto 3 da
# arquitetura da parceria): sandbox funcional, testes de contrato feitos,
# DPA assinado e critérios de go-live cumpridos.
#
# Com a bandeira a "false" (ou ausente), nada da FIZ aparece na interface e
# nenhuma chamada é feita — os Guias e simuladores funcionam na mesma.
# SÓ a palavra "true" liga; qualquer outro valor deixa desligado.
NEXT_PUBLIC_FIZ_ENABLED=false

# A porta do SERVIDOR, separada da de cima de propósito (RC-FIZ-002). A
# bandeira NEXT_PUBLIC_ fica gravada no build, por isso um build antigo com a
# integração ligada continuaria a poder falar com o servidor depois de alguém
# a desligar. As rotas /api/integrations/fiz/* consultam ESTA, e respondem 503
# sem ler o corpo do pedido enquanto ela não for "true".
FIZ_ENABLED=false

# "sandbox" (por omissão) ou "production".
FIZ_ENVIRONMENT=sandbox

# Credenciais de parceiro (Client Credentials). NUNCA usar prefixo
# NEXT_PUBLIC_ — estes valores não podem chegar ao browser.
FIZ_CLIENT_ID=
FIZ_CLIENT_SECRET=

# Segredo partilhado para verificar a assinatura HMAC dos webhooks.
FIZ_WEBHOOK_SECRET=

# Chave de cifra dos tokens delegados em repouso (AES-256-GCM).
# Gerar com:  openssl rand -base64 32
FIZ_TOKEN_ENCRYPTION_KEY=

# Código de atribuição comercial acordado com a FIZ.
FIZ_REFERRAL_CODE=recibocerto

# Necessária para as rotas que leem/escrevem em partner_connections,
# partner_handoffs e partner_events (ignoram RLS por desenho).
SUPABASE_SERVICE_ROLE_KEY=

# Pré-visualização da integração (só para rever o desenho).
# Com NEXT_PUBLIC_FIZ_ENABLED=true e isto a "true", a interface usa um
# catálogo de capacidades LOCAL: vê-se o percurso completo, incluindo o ecrã
# de consentimento, mas nada sai para a rede e nenhuma ação é executada.
# Desliga-se sozinha assim que existirem FIZ_CLIENT_ID e FIZ_CLIENT_SECRET.
NEXT_PUBLIC_FIZ_PREVIEW=false

# ── Parcerias configuráveis (Fase 1 — afiliado) ─────────────────────────
#
# Interruptor de emergência: "true" desliga TODAS as parcerias em qualquer
# ambiente.
#
# A primeira versão era ao contrário (`PARCERIAS_ATIVAS=true` para LIGAR) e o
# efeito foi este: como ninguém definia a variável, o passo de ligação nunca
# corria e o site mostrava a pré-visualização da Fase 2 — um diálogo de
# consentimento a prometer transporte de dados — em vez da parceria real.
# Uma parceria contratada está ligada por omissão.
#
# Para rever o desenho do handoff da Fase 2 num deploy de ramo, usa antes
# NEXT_PUBLIC_FIZ_PREVIEW=true: aí a pré-visualização passa à frente.
PARCERIAS_DESLIGADAS=false

# Desliga o registo de cliques SEM desligar os links. Útil para separar um
# problema de medição de um problema de destino.
PARCERIAS_CLIQUES_ATIVOS=true

# NOTA: o link de afiliado NÃO vive aqui. Vive em `admin_partners`
# (`link_afiliado` e `link_afiliado_registo`), para poder mudar sem deploy.
# `FIZ_REFERRAL_CODE`, acima, é o código usado pelas chamadas de referral da
# API na Fase 2 — não é o link de afiliado e não deve ser reaproveitado como
# tal.

# ── Quiz Fiscal ─────────────────────────────────────────────────────
# Travão administrativo da emissão automática de cupões (RC-QUIZ-001).
# Por omissão LIGADO — os cupões continuam a ser emitidos como hoje.
# Pôr a "false" suspende só a EMISSÃO: o progresso continua a ser contado com
# verdade e o ciclo fecha na mesma, ficando o cupão para emitir à mão. É o
# interruptor a usar se aparecer abuso, sem ter de tirar o Quiz do ar.
QUIZ_PREMIOS_AUTOMATICOS=true
